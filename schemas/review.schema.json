{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "report_digest": {
      "title": "Report Digest",
      "type": "string"
    },
    "reviewer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "agreement": {
      "enum": [
        "agree",
        "disagree",
        "partly"
      ],
      "title": "Agreement",
      "type": "string"
    },
    "corrected_explanation": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Corrected Explanation",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "report_digest",
    "reviewer",
    "agreement",
    "corrected_explanation",
    "evidence_ids"
  ],
  "title": "Review",
  "type": "object"
}
