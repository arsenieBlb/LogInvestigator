{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "source_id",
        "line_start",
        "line_end"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "likely",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "supporting_observations": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Supporting Observations",
          "type": "array"
        },
        "conflicting_observations": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Conflicting Observations",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "status"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "evidence_ids"
      ],
      "title": "Observation",
      "type": "object"
    },
    "TimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "timestamp",
        "text",
        "evidence_ids"
      ],
      "title": "TimelineEntry",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "result_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Result Bytes",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "name",
        "duration_ms"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "question": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "time_window": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Time Window",
      "type": "object"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "implementation_version": {
      "default": "0.1.0",
      "title": "Implementation Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "mode": {
      "default": "baseline",
      "enum": [
        "baseline",
        "replay",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "partial": {
      "default": false,
      "title": "Partial",
      "type": "boolean"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEntry"
      },
      "maxItems": 200,
      "title": "Timeline",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "maxItems": 200,
      "title": "Observations",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "maxItems": 30,
      "title": "Hypotheses",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 500,
      "title": "Evidence",
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Missing Evidence",
      "type": "array"
    },
    "alternative_explanations": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Alternative Explanations",
      "type": "array"
    },
    "next_checks": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Next Checks",
      "type": "array"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "maxItems": 100,
      "title": "Tool Calls",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "limits_reached": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Limits Reached",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "question"
  ],
  "title": "Report",
  "type": "object"
}
